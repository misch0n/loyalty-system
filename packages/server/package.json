{
  "name": "@cafe/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Café Loyalty production backend — Fastify + PostgreSQL.",
  "scripts": {
    "predev": "npm --prefix ../shared run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "npm --prefix ../shared run build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm --prefix ../shared run build",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node dist/migrate.js",
    "bootstrap": "node dist/bootstrap.js",
    "pretest": "npm --prefix ../shared run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@cafe/shared": "*",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^2.0.5"
  }
}
