# @cafe/server — runtime configuration.
#
# Unlike the SPA's `packages/web/.env.example`, NOTHING here is baked into a public
# bundle: these are real server-side secrets. Copy to `.env` (gitignored) for
# local development; in production they come from the environment, never a
# committed file. Every variable below is validated at boot by `src/env.ts` —
# a missing or malformed one exits the process rather than failing later.

# --- required ---------------------------------------------------------------

# PostgreSQL connection string. Carries a password; never logged.
DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafe_loyalty

# --- optional, with defaults ------------------------------------------------

# development | test | production   (default: development)
NODE_ENV=development
# default: 0.0.0.0
HOST=0.0.0.0
# default: 3000
PORT=3000
# fatal | error | warn | info | debug | trace | silent
# (default: info, or silent under NODE_ENV=test)
LOG_LEVEL=info

# --- sessions ---------------------------------------------------------------

# `Secure` on the session cookies: HTTPS only. Defaults to true under
# NODE_ENV=production and false elsewhere, because a plain-HTTP dev server
# cannot receive a Secure cookie at all. It CANNOT be set to false in
# production — the server refuses to boot.
# COOKIE_SECURE=false

# Extra origins accepted on mutating requests, comma-separated bare origins.
# Empty in the deployed bundle, where nginx serves the SPA and the API from one
# origin; a Vite dev server on another port needs listing here.
# ALLOWED_ORIGINS=http://localhost:5173

# --- outbound mail (both together, or both unset) ---------------------------
#
# SMTP covers every case: mailpit in the dev Compose override, and SES / Brevo /
# Resend in production — all three speak it, so changing provider is a change
# here and nowhere in the code. With these unset the server still runs and LOGS
# what it would have sent, which is right for a test run and wrong in production:
# nobody can recover a card without mail, so the absence is warned about at boot.
#
# Carries a password; never logged, and never echoed in a validation error.
# MAIL_SMTP_URL=smtp://localhost:1025
# Envelope sender. A bare address or a display name plus one.
# MAIL_FROM="Ckyka" <no-reply@example.test>

# Public origin of the SPA, used to build the card links in outbound mail — the
# server cannot infer it, because behind Cloudflare the request host is the
# proxy's. REQUIRED once mail is configured; a link pointing at localhost in a
# customer's inbox is a silent failure. Include any base path the SPA is served
# under; the `#` route is appended.
# APP_URL=https://cafe.example

# --- first admin (all three together, or all unset) -------------------------
#
# Used ONCE, by `npm run bootstrap`, on a database with no admin account. It can
# never reset a live credential: once any admin exists the bootstrap is a no-op.
# Password: 8+ characters. PIN: 4-8 digits.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PIN=
# Display/attribution label. Optional; falls back to the username.
BOOTSTRAP_ADMIN_NAME=

# --- tests ------------------------------------------------------------------
#
# Most of the suite runs against a REAL Postgres (it asserts the constraints,
# row locks and append-only triggers that are the whole point of moving off
# IndexedDB). Defaults to the URL below, and the run FAILS in `globalSetup` if
# nothing is reachable — a suite that proves the two stores agree is worthless
# skipped, and worse than worthless when the skip reports green.
# TEST_DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafe_loyalty_test
