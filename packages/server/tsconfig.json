{
  // The type-check config: everything under `src`, tests included, no emit.
  // `tsconfig.build.json` is what produces `dist/`.
  //
  // Standalone — deliberately NOT referenced from the SPA's solution tsconfig.
  // The two packages share `@cafe/shared` and nothing else.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],

    // `NodeNext`, where Phases 0–5 had to use `Bundler`. The blocker was that the
    // shared `domain/`+`ports/` sources reached this project through a path alias
    // and used extensionless relative specifiers, which NodeNext rejects — so the
    // server could not emit anything Node would run, and `dev`/`start` went
    // through `tsx`. Phase 10 made `@cafe/shared` a real workspace package
    // resolved through its `exports` map, and gave every relative specifier here
    // its `.js` extension. The server now emits and runs on plain `node`.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"]
}
