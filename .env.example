# Docker Compose configuration for the Café Loyalty bundle.
#
#   cp .env.example .env     then fill in the four values marked REQUIRED
#
# Compose reads this file automatically from beside `compose.yml`. `.env` is
# gitignored and carries real secrets; this file carries none and is committed.
#
# These are the BUNDLE's variables. The server's own are documented one level
# down in `packages/server/.env.example`, which is what you want when running the
# API outside Compose — every value below is passed through to it.

# --- REQUIRED ---------------------------------------------------------------
#
# The database. `compose.yml` builds DATABASE_URL from these three, so the
# password must be URL-safe: no `@`, `:`, `/` or `#`. Generate one with
# `openssl rand -base64 24 | tr -d '+/='`.
POSTGRES_USER=cafe
POSTGRES_PASSWORD=
POSTGRES_DB=cafe_loyalty

# The first admin account, created once by the `migrate` container on a database
# with no admin. It can never reset a live credential — once any admin exists the
# bootstrap is a no-op — so leaving these set across deploys is safe.
#
# Without them the stack comes up with NOBODY ABLE TO SIGN IN: every staff route
# is admin-tier, so there is no way to create the first account over HTTP. The
# migrate container warns loudly when they are missing.
#
# Password: 8+ characters. PIN: 4-8 digits.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PIN=
# Display/attribution label — the name on the staff panel and in the audit log.
# Optional; falls back to the username.
BOOTSTRAP_ADMIN_NAME=

# --- outbound mail ----------------------------------------------------------
#
# Set together or leave both unset. Unset, the server still runs and LOGS what it
# would have sent, which is right for a first bring-up and wrong for a café:
# nobody can recover a lost card without mail.
#
# SMTP covers every provider the plan names — SES, Brevo, Resend — so changing
# provider is a change here and nowhere in the code. The dev override points this
# at mailpit for you.
# MAIL_SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="Ckyka" <no-reply@cafe.example>

# Public origin of the SPA. REQUIRED once mail is configured: it is what the card
# links in outbound mail point at, and the server cannot infer it — behind
# Cloudflare the request host is the proxy's. A link to `localhost` in a
# customer's inbox is a silent failure.
# APP_URL=https://cafe.example

# --- ports ------------------------------------------------------------------
#
# nginx, the only service meant to be reachable from outside the host. Put TLS in
# front of it (Cloudflare, or a host-level reverse proxy) — the bundle speaks
# plain HTTP and the session cookies are `Secure`, so it will not work over HTTP
# in production, by design.
WEB_PORT=8080

# The API, published on 127.0.0.1 only, for probing `/readyz` and for use while
# the `web` service is behind a profile.
API_PORT=3000

# Dev override only (`compose.dev.yml`).
# DB_PORT=5432
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025

# --- backups ----------------------------------------------------------------
#
# Where `ops/backup.sh` writes, on the host, and how many dumps to keep. The
# directory is bind-mounted so an operator can copy them off the machine —
# a backup that only exists on the box the database is on is not a backup.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# --- advanced ---------------------------------------------------------------
#
# fatal | error | warn | info | debug | trace | silent   (default: info)
# LOG_LEVEL=info

# `Secure` on the session cookies. Defaults to true, and the server REFUSES to
# boot with it false under NODE_ENV=production. The dev override sets it false
# there, where NODE_ENV is development and a plain-HTTP page cannot receive a
# Secure cookie at all.
# COOKIE_SECURE=true

# Extra origins accepted on mutating requests, comma-separated. Empty in the
# bundle, where nginx serves the SPA and the API from one origin.
# ALLOWED_ORIGINS=
